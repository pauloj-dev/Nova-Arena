{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "storybook-static/**"],
      "passThroughEnv": ["VERCEL", "DATABASE_URL", "DATABASE_URL_UNPOOLED", "DIRECT_URL", "FORCE_MIGRATE"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "typecheck": {},
    "test": { "env": ["TEST_DATABASE_URL"] },
    "test:coverage": { "outputs": ["coverage/**"] }
  }
}
