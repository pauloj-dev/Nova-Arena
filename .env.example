# Variáveis de ambiente da Nova Arena (plano §2 e B1.1).
#
# Este arquivo é só o catálogo: NUNCA coloque valores reais aqui.
# - Na Vercel, cadastre por ambiente (Development, Preview, Staging, Production) e marque como
#   "Sensitive" tudo o que não começa com NEXT_PUBLIC_. As integrações do Marketplace criam
#   as delas sozinhas (indicado em cada bloco).
# - No computador, copie para `apps/web/.env.local` (ignorado pelo git) ou rode `vercel env pull`.
# - As variáveis são validadas com Zod quando a API sobe (issue #65): faltando alguma, ela não sobe.

# ── App ──────────────────────────────────────────────────────────────
# URL pública do site, sem barra no fim. Nunca fixe o domínio no código (ADR-0001, Q7).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API simulada (MSW): all (padrão) · none · lista de módulos (auth,games). Em produção: none.
NEXT_PUBLIC_API_MOCK=all

# ── Banco: Neon Postgres (Marketplace, cria sozinho) ─────────────────
# Com pooler: usado pela aplicação (funções escalam para muitas instâncias).
DATABASE_URL=
# Sem pooler: só para migrations (`prisma migrate deploy`).
DATABASE_URL_UNPOOLED=

# ── Cache, rate limit e idempotência: Upstash Redis (Marketplace, cria sozinho) ──
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Jobs: Upstash QStash (Marketplace, cria sozinho) ─────────────────
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── Vercel Cron: segredo que o Cron manda no cabeçalho Authorization ──
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ── Arquivos: Vercel Blob (store do projeto, cria sozinho) ───────────
BLOB_READ_WRITE_TOKEN=

# ── Feature flags e configurações: Vercel Edge Config (store do projeto, cria sozinho) ──
EDGE_CONFIG=
# Token da API da Vercel com permissão de escrita no Edge Config (o painel Admin edita as flags, B2.6).
VERCEL_API_TOKEN=
EDGE_CONFIG_ID=

# ── E-mail: Resend (Marketplace, cria sozinho) ───────────────────────
RESEND_API_KEY=
# Remetente de um domínio verificado no Resend, ex.: "Nova Arena <nao-responda@novaarena.gg>".
EMAIL_FROM=

# ── Erros: Sentry (Marketplace, cria sozinho) ────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── Tempo real: Ably (conta própria, fora do Marketplace) ────────────
# Chave com permissão de publicar e emitir token. Só no servidor: o navegador recebe token da nossa API.
ABLY_API_KEY=

# ── Autenticação (B1.2) ──────────────────────────────────────────────
# Segredo do JWT de acesso (mínimo 32 bytes aleatórios). Um valor diferente por ambiente.
AUTH_JWT_SECRET=
# OAuth Google (Google Cloud Console → Credenciais). Redirect: <SITE_URL>/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth Discord (Discord Developer Portal → OAuth2). Redirect: <SITE_URL>/api/v1/auth/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Código da sala cifrado (B2.2): AES-256-GCM, 32 bytes em base64 ──
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LOBBY_ENCRYPTION_KEY=
