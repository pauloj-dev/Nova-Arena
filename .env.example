# Variáveis de ambiente da Nova Arena (plano §2 e B1.1).
#
# Este arquivo é só o catálogo: NUNCA coloque valores reais aqui.
# - Na Vercel, cadastre por ambiente (Development, Preview, Staging, Production) e marque como
#   "Sensitive" tudo o que não começa com NEXT_PUBLIC_. As integrações do Marketplace criam
#   as delas sozinhas (indicado em cada bloco).
# - No computador, copie para `apps/web/.env.local` (ignorado pelo git) ou rode `vercel env pull`.
# - As variáveis são validadas com Zod quando a API sobe (issue #65): faltando alguma, ela não sobe.

# ── App ──────────────────────────────────────────────────────────────
# URL pública do site, sem barra no fim. Nunca fixe o domínio no código (ADR-0001, Q7).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API simulada (MSW): all (padrão) · none · lista de módulos (auth,games). Em produção: none.
NEXT_PUBLIC_API_MOCK=all
# Preview, staging e produção: none (todos os módulos têm API real desde a #102; docs/infra-vercel.md §9).

# ── Banco: Neon Postgres (Marketplace, cria sozinho) ─────────────────
# Com pooler: usado pela aplicação (funções escalam para muitas instâncias).
DATABASE_URL=
# Sem pooler: só para migrations (`prisma migrate deploy`).
DATABASE_URL_UNPOOLED=

# ── Cache, rate limit e idempotência: Upstash Redis (Marketplace, cria sozinho) ──
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Opcional: prefixo das chaves quando o mesmo Redis serve a mais de um ambiente (ex.: `preview:`). Local: `dev:`.
KV_PREFIX=

# ── Jobs: Upstash QStash (Marketplace, cria sozinho) ─────────────────
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── Vercel Cron: segredo que o Cron manda no cabeçalho Authorization ──
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ── Arquivos: Vercel Blob (store do projeto, cria sozinho) ───────────
BLOB_READ_WRITE_TOKEN=
# Loja privada do Blob para provas e denúncias (issue #73). Se ficar vazia, usa a de cima com acesso privado.
BLOB_PRIVATE_READ_WRITE_TOKEN=

# ── Feature flags e configurações: Vercel Edge Config (store do projeto, cria sozinho) ──
EDGE_CONFIG=
# Token da API da Vercel com permissão de escrita no Edge Config (o painel Admin edita as flags, B2.6).
VERCEL_API_TOKEN=
EDGE_CONFIG_ID=
# Só quando o token é de um time da Vercel.
VERCEL_TEAM_ID=

# ── E-mail: Resend (Marketplace, cria sozinho) ───────────────────────
RESEND_API_KEY=
# Remetente de um domínio verificado no Resend, ex.: "Nova Arena <nao-responda@novaarena.gg>".
EMAIL_FROM=

# ── Erros: Sentry (Marketplace, cria sozinho) ────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── Tempo real: Ably (conta própria, fora do Marketplace) ────────────
# Chave com permissão de publicar e emitir token. Só no servidor: o navegador recebe token da nossa API.
ABLY_API_KEY=

# ── Autenticação (B1.2) ──────────────────────────────────────────────
# Segredo do JWT de acesso (mínimo 32 bytes aleatórios). Um valor diferente por ambiente.
AUTH_JWT_SECRET=
# OAuth Google (Google Cloud Console → Credenciais). Redirect: <SITE_URL>/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth Discord (Discord Developer Portal → OAuth2). Redirect: <SITE_URL>/api/v1/auth/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Código da sala cifrado (B2.2): AES-256-GCM, 32 bytes em base64 ──
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LOBBY_ENCRYPTION_KEY=

# ── Verificação em duas etapas (B2.7, issue #95): AES-256-GCM do segredo TOTP, 32 bytes em base64 ──
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar a chave invalida o 2FA de todas as contas (cada pessoa precisa configurar de novo): guarde-a bem.
TWO_FACTOR_ENCRYPTION_KEY=

# ── Push no PWA (issue #109): chaves VAPID do Web Push ───────────────
# Gere o par com: npx web-push generate-vapid-keys  (a pública vai para o navegador; a privada só no servidor)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato que os serviços de push exigem: mailto:suporte@novaarena.gg
VAPID_SUBJECT=

# ── Bot do Discord (issue 121): avisos e check-in por comando ────────
# Discord Developer Portal → sua aplicação. Sem as três, o bot fica desligado (o resto do site funciona).
# "Interactions Endpoint URL" da aplicação: <SITE_URL>/api/v1/discord/interactions
# Registrar os comandos: node ops/discord/register-commands.mts (com DISCORD_GUILD_ID para testar num servidor)
DISCORD_APP_ID=
# General Information → Public Key (verifica a assinatura Ed25519 de cada interação)
DISCORD_PUBLIC_KEY=
# Bot → Token (envia os avisos no canal vinculado). Só no servidor.
DISCORD_BOT_TOKEN=

# Seed fora de produção: senha das contas de demonstração (E2E com a API real, issue #81).
SEED_DEMO_PASSWORD=
# Opcional, fora de produção: segredo TOTP (Base32) do 2FA do Rafael e da Ana na seed de demonstração (pnpm --filter web seed:demo).
SEED_DEMO_TOTP_SECRET=
