{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @nova/db db:generate && pnpm --filter @nova/db db:deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p sw/tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "lhci": "lhci autorun --config=lighthouserc.cjs",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^7.0.8",
    "@nova/api": "workspace:*",
    "@nova/db": "workspace:*",
    "@nova/engine": "workspace:*",
    "@nova/schemas": "workspace:*",
    "@nova/ui": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.2",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-logs": "^0.223.2",
    "@opentelemetry/sdk-metrics": "^2.12.1",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@sentry/nextjs": "^11.17.0",
    "@serwist/turbopack": "9.5.15",
    "@serwist/window": "9.5.15",
    "@tanstack/react-query": "^5.108.4",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.9.0",
    "@vercel/otel": "^2.3.0",
    "@vercel/speed-insights": "^2.1.0",
    "ably": "^2.30.0",
    "botid": "^1.5.13",
    "dompurify": "^3.5.0",
    "lucide-react": "^1.78.0",
    "msw": "^3.0.7",
    "next": "16.4.6",
    "next-intl": "4.16.0",
    "papaparse": "^5.7.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.11.0",
    "server-only": "^0.0.1",
    "serwist": "9.5.15",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@nova/config": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "0.28.2",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-i18next": "6.1.5",
    "jsdom": "^31.0.1",
    "pg": "^8.23.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.1.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
