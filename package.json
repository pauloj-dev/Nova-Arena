{
  "name": "nova-arena",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "e2e": "pnpm --filter web e2e",
    "storybook": "pnpm --filter @nova/ui storybook",
    "prepare": "lefthook install || true",
    "check:colors": "node packages/ui/scripts/check-colors.mjs packages/ui/src apps/web/app apps/web/features apps/web/shared"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "lefthook": "^2.0.0",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3"
  }
}
