{
  "name": "@nova/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/theme.css": "./src/styles/theme.css",
    "./check-colors": {
      "types": "./scripts/check-colors.d.mts",
      "default": "./scripts/check-colors.mjs"
    }
  },
  "scripts": {
    "lint": "eslint . && node scripts/check-colors.mjs src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:colors": "node scripts/check-colors.mjs src",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.0.0",
    "radix-ui": "^1.4.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@nova/config": "workspace:*",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^31.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "^10.6.7",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  }
}
